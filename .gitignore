# Local encrypted database + SQLCipher migration backups — user data, never commit.
slate_data/
*.pre-rawkey.bak

# Scratch / analysis artifacts that accumulated in the repo root.
analyze_*.txt
analyze_*.bat
analyze_genesis.txt
out.txt
recovered_*.txt
native/build_*.txt
dart_devtools_*.json
# Loose scratch Dart snippets (not part of the app or the test suite).
/test_create.dart
/test_encoding.dart
.claude/settings.json

# e2e capture output (screenshots, flash frames) - evidence, not source
/tools/e2e/_*/

# Demo-recording scratch state: the last cursor path and the last take's beat
# timings. The demo scripts rewrite these on every run - working files, not
# source, and committing them would make every recording session a diff.
/tools/.last_*.txt

# Third-party MCP bridge to After Effects. Its own git repo, cloned here for
# convenience - committing it would leave a broken submodule pointer behind.
/after-effects-mcp/

# Raw notes from live testing: a verbatim chat log with a named person and a
# working screenshot. The findings from both are written up in
# docs/user_findings.md, which is what belongs in source. The raw material is
# someone else's conversation and it does not go in a repository.
/timur_chat
/slate_shot_capture.png
